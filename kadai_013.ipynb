      "source": [
        "def calculate_price_with_tax(price, tax):\n",
        "    \"\"\"商品の金額に消費税を加えた合計金額を返す\"\"\"\n",
        "    return price + (price * tax // 100)\n",
        "\n",
        "\n",
        "result = calculate_price_with_tax(110, 10)\n",
        "print(f\"消費税込みの金額: {result}円\")"
      ]
    }
